# Directory on the host where all application data (SQLite DB, and later
# images/models/runs) is stored. Bind-mounted into the containers. See D-13.
DATA_DIR=./data

# Interface the web (nginx) service publishes its port on.
# WARNING: setting this to 0.0.0.0 exposes the app to your whole local
# network with NO authentication (v1 has none). Only do this if you
# understand and accept that risk.
BIND_ADDR=127.0.0.1

# Host port the web service is published on.
PORT=8080

# SQLite journal mode used by the api. WAL (the default) gives better
# concurrent-read throughput. Set this to DELETE only if you ever see
# "database disk image is malformed" after a restart on Docker Desktop for
# Windows/macOS (a known cross-VM bind-mount risk - see README). Native
# Linux Docker hosts are not affected and should keep WAL.
SQLITE_JOURNAL_MODE=WAL

# Comma-separated list of Host headers the api will accept (or `*` to accept
# any). Defaults to localhost/127.0.0.1 to blunt DNS-rebinding against this
# unauthenticated, local-only service. If you opt into LAN access with
# BIND_ADDR=0.0.0.0 above, add this machine's LAN IP or hostname here (or use
# `*`) - remember the service still has NO authentication, so anyone who can
# reach that host/IP has full access.
ALLOWED_HOSTS=localhost,127.0.0.1

# Maximum size of one uploaded image, in megabytes. The nginx proxy allows
# upload requests up to this many MiB, so a file right at the limit always
# reaches the api (which enforces the exact per-file limit). Applies to the
# image upload route only; every other route keeps a 1 MiB body limit.
MAX_UPLOAD_MB=50
