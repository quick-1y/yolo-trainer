# syntax=docker/dockerfile:1
FROM python:3.12-slim AS base

ENV PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

# Pin to the same uv version that produced uv.lock, for reproducible resolution.
ARG UV_VERSION=0.12.19
RUN pip install --no-cache-dir "uv==${UV_VERSION}"

WORKDIR /app

COPY pyproject.toml uv.lock .python-version ./
COPY backend/pyproject.toml backend/pyproject.toml
COPY backend/src backend/src

# ---- api target: light image, no torch (D-17) ----
FROM base AS api
RUN uv sync --frozen --no-dev --package yolo-trainer-backend

ENV DATA_DIR=/data
EXPOSE 8000

CMD ["/app/.venv/bin/uvicorn", "yolo_trainer_api.main:app", "--host", "0.0.0.0", "--port", "8000"]

# ---- worker target: heavy image, torch CPU + ultralytics (D-17) ----
FROM base AS worker

# Ultralytics' opencv-python dependency needs these runtime libs on a slim
# base image even though we never use a display (RESEARCH "Common Pitfalls" #4).
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# One download at a time with a generous timeout: on Docker Desktop (Windows)
# parallel multi-hundred-MB wheel downloads (torch) fail with
# "error reading a body from connection".
ENV UV_CONCURRENT_DOWNLOADS=1 \
    UV_HTTP_TIMEOUT=300

RUN uv sync --frozen --no-dev --package yolo-trainer-backend --extra worker

ENV DATA_DIR=/data \
    YOLO_CONFIG_DIR=/tmp/ultralytics

STOPSIGNAL SIGTERM

CMD ["/app/.venv/bin/python", "-m", "yolo_trainer_worker.main"]
