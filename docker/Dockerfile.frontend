# syntax=docker/dockerfile:1
FROM node:24-alpine AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
# One socket at a time: on Docker Desktop (Windows) parallel registry
# connections are reset (ECONNRESET) and `npm ci` fails; serial is reliable.
RUN npm ci --maxsockets=1
COPY frontend/ ./
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
# The nginx image renders /etc/nginx/templates/*.template into conf.d with envsubst
# at start-up; the default keeps the config valid when run without compose.
ENV MAX_UPLOAD_MB=50
COPY docker/nginx.conf.template /etc/nginx/templates/default.conf.template
